<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.program.hubtopwizard" name="Hubtop Build Wizard" version="1.0.0" provider-name="j-netzen">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Installs the Hubtop build</summary>
    <description>Downloads the Hubtop build zip from GitHub and installs it into Kodi.</description>
    <platform>all</platform>
  </extension>
</addon>

<addon id="repository.jnetzen" name="J-Netzen Repo" version="1.0.0" provider-name="j-netzen">
  <extension point="xbmc.addon.repository" name="J-Netzen Repo">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/j-netzen/kodi-repo/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/j-netzen/kodi-repo/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/j-netzen/kodi-repo/main/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>J-Netzen Kodi Repo</summary>
    <description>Personal addon repository</description>
    <platform>all</platform>
  </extension>
</addon>

<addon id="script.hubtop.buildwizard" name="HubTop Build Wizard" version="2.0.0" provider-name="hubtop">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Installs the HubTop build from a download link or a zip file</summary>
    <description lang="en_GB">Downloads (with resume) or loads the HubTop build zip and installs it into Kodi. Kodi closes when the install finishes.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
  </extension>
</addon>

</addons>
